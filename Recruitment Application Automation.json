    {
      "parameters": {
        "jsCode": "const raw = $json.text ?? $json.output;\n\nif (!raw) {\n  throw new Error('No AI response found');\n}\n\nlet cleaned = raw.trim();\n\ncleaned = cleaned\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/\\s*```$/i, '');\n\nconst parsed = JSON.parse(cleaned);\n\nreturn {\n  json: parsed\n};"
