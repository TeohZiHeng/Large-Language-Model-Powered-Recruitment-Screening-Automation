    {
      "parameters": {
        "promptType": "define",
        "text": "=Please analyse this candidate for the position of:\n\nPosition:\n{{ $('On form submission').item.json['Position Applied for'] }}\n\nResume:\n{{ $json.text }}\n\nEvaluate the candidate based on:\n1. Education relevance\n2. Technical skills\n3. Work experience\n4. Relevance to the applied position\n5. Overall suitability\n\nBase the evaluation only on information explicitly available in the resume.\n\nReturn the evaluation according to the required structured output format.",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=Return ONLY valid JSON.\n\nThe response must follow exactly this structure:\n\n{\n  \"score\": 0,\n  \"recommendation\": \"Shortlist\",\n  \"key_strengths\": [],\n  \"key_concerns\": [],\n  \"summary\": \"\"\n}\n\nRules:\n- score must be an integer from 0 to 100\n- recommendation must be exactly one of:\n  \"Shortlist\", \"Consider\", \"Reject\"\n- key_strengths must be an array of strings\n- key_concerns must be an array of strings\n- summary must be a string\n- Do not use markdown\n- Do not use ```json\n- Do not include any text before or after the JSON"
            }
          ]
        },
        "batching": {}
      },
